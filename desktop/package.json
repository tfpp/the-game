{
  "name": "the-game-desktop",
  "productName": "The Game",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop host for The Game website",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "package": "electron-packager . TheGame --out=dist --overwrite --ignore=^/test --ignore=^/dist",
    "package:linux": "npm run package -- --platform=linux --arch=x64,arm64",
    "package:mac": "npm run package -- --platform=darwin --arch=x64,arm64",
    "package:windows": "npm run package -- --platform=win32 --arch=x64,arm64"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "@electron/packager": "20.3.0"
  }
}
