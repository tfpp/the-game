[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://features/combat/combat.gd" id="1"]
[ext_resource type="Script" path="res://features/combat/combat_hud.gd" id="2"]
[ext_resource type="Theme" path="res://ui/theme/hud_theme.tres" id="hud_theme"]
[ext_resource type="FontFile" path="res://assets/fonts/barlow/Barlow-SemiBold.ttf" id="hud_font"]

[sub_resource type="SceneReplicationConfig" id="Replication"]
properties/0/path = NodePath(".:kills")
properties/0/spawn = true
properties/0/replication_mode = 2

[node name="Combat" type="Node"]
script = ExtResource("1")

[node name="Sync" type="MultiplayerSynchronizer" parent="."]
root_path = NodePath("..")
replication_config = SubResource("Replication")

[node name="Hud" type="CanvasLayer" parent="."]
layer = 20
script = ExtResource("2")

[node name="Health" type="ProgressBar" parent="Hud"]
offset_right = 200.0
offset_bottom = 20.0
mouse_filter = 2
theme = ExtResource("hud_theme")
theme_type_variation = &"HudBar"
value = 100.0
show_percentage = false

[node name="Value" type="Label" parent="Hud/Health"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.96, 0.92, 0.82, 1)
theme_override_colors/font_outline_color = Color(0.1, 0.03, 0.02, 1)
theme_override_constants/outline_size = 4
theme_override_fonts/font = ExtResource("hud_font")
theme_override_font_sizes/font_size = 13
text = "100 HP"
horizontal_alignment = 1
vertical_alignment = 1

[node name="DeathScreen" type="ColorRect" parent="Hud"]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.04, 0.01, 0.015, 0.96)

[node name="Died" type="Label" parent="Hud/DeathScreen"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
text = "u died gg"
theme_override_colors/font_color = Color(1, 0.3, 0.3, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 6
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1
vertical_alignment = 1
