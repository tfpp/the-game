[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
macos = "res://features/gun_inspect/bin/libgun_inspect.dylib"
linux.x86_64 = "res://features/gun_inspect/bin/libgun_inspect.so"
windows.x86_64 = "res://features/gun_inspect/bin/gun_inspect.dll"
web.wasm32 = "res://features/gun_inspect/bin/gun_inspect.wasm"
