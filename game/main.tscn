[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://core/game/game.gd" id="1_game"]
[ext_resource type="PackedScene" path="res://features/casino_hub/gridmap/playable.tscn" id="2_room"]
[ext_resource type="PackedScene" path="res://ui/hud.tscn" id="3_hud"]
[ext_resource type="PackedScene" path="res://ui/login/login_screen.tscn" id="4_login"]

[node name="Game" type="Node3D"]
script = ExtResource("1_game")

[node name="Room" parent="." instance=ExtResource("2_room")]

[node name="Features" type="Node3D" parent="."]
metadata/excluded_features = PackedStringArray("annex", "casino_wing", "frogs", "penguin", "water", "nyc_ferry", "gnomes", "wall_sconces")

[node name="Players" type="Node3D" parent="."]

[node name="PlayerSpawner" type="MultiplayerSpawner" parent="."]
spawn_path = NodePath("../Players")

[node name="HUD" parent="." instance=ExtResource("3_hud")]

[node name="LoginScreen" parent="." instance=ExtResource("4_login")]
