{
  "type": "module",
  "name": "@oh-my-pi/omptype",
  "version": "18.3.0",
  "description": "ArkType-compatible runtime schema validation with lazy JIT compilation",
  "homepage": "https://omp.sh",
  "author": {
    "name": "Stencil Labs, Inc.",
    "url": "https://stencil.so"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/omptype"
  },
  "bugs": {
    "url": "https://github.com/can1357/oh-my-pi/issues"
  },
  "keywords": [
    "schema",
    "validation",
    "arktype",
    "jit"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  }
}
