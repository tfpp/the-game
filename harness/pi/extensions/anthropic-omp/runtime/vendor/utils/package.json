{
  "name": "@oh-my-pi/pi-utils",
  "version": "18.3.0",
  "description": "Shared utilities for pi packages",
  "keywords": [
    "cli",
    "logging",
    "streams",
    "utilities"
  ],
  "homepage": "https://omp.sh",
  "bugs": {
    "url": "https://github.com/can1357/oh-my-pi/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Stencil Labs, Inc.",
    "url": "https://stencil.so"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/utils"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./ar": {
      "types": "./src/ar/index.ts",
      "import": "./src/ar/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  },
  "dependencies": {
    "@oh-my-pi/pi-natives": "workspace:*"
  },
  "engines": {
    "bun": ">=1.3.14"
  }
}
